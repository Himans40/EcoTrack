# ---------------------------------------------------------------------------
# Environment Monitoring System - example environment file
# ---------------------------------------------------------------------------
# NOTE: This project works with NO configuration at all.
# Every data source it uses (Open-Meteo Air Quality, Open-Meteo Weather,
# Open-Meteo Geocoding and OpenStreetMap tiles) is free and key-less.
#
# These variables only exist so the API base URLs can be overridden,
# for example to point at a cached proxy during a classroom demo.
# Copy this file to `.env` only if you actually need to change them.
# ---------------------------------------------------------------------------

# Open-Meteo Air Quality API (US AQI + pollutant concentrations)
VITE_AIR_QUALITY_API_BASE=https://air-quality-api.open-meteo.com/v1/air-quality

# Open-Meteo Weather Forecast API (temperature, humidity, wind)
VITE_WEATHER_API_BASE=https://api.open-meteo.com/v1/forecast

# Open-Meteo Geocoding API (city search)
VITE_GEOCODING_API_BASE=https://geocoding-api.open-meteo.com/v1/search

# OpenStreetMap raster tile template used by the Leaflet map
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
