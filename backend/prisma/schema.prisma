// EcoTrack Prisma schema
// SQLite keeps the backend zero-setup: the database is a single file created
// by `npm run setup`, so the project runs on any machine without a DB server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./ecotrack.db"
}

/// Represents a geographic monitoring station / location
model Location {
  id            Int            @id @default(autoincrement())
  name          String
  lat           Float          // Latitude
  lng           Float          // Longitude
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 1-to-many relationship with telemetry readings
  airReadings   AirReading[]
  waterReadings WaterReading[]

  @@map("locations")
}

/// Represents an Air Quality sensor snapshot
model AirReading {
  id         Int      @id @default(autoincrement())
  locationId Int
  pm25       Float    // Particulate Matter ≤ 2.5 µm (µg/m³)
  pm10       Float    // Particulate Matter ≤ 10 µm (µg/m³)
  no2        Float    // Nitrogen Dioxide (ppb / µg/m³)
  aqiScore   Float    // Calculated Air Quality Index (0 - 500)
  timestamp  DateTime @default(now())

  // Relation with cascade on delete
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([timestamp])
  @@map("air_readings")
}

/// Represents a Water Quality sensor snapshot
model WaterReading {
  id              Int      @id @default(autoincrement())
  locationId      Int
  ph              Float    // Potential of Hydrogen (0 - 14)
  turbidity       Float    // Turbidity (NTU)
  dissolvedOxygen Float    // Dissolved Oxygen (mg/L)
  wqiScore        Float    // Calculated Water Quality Index (0 - 100)
  timestamp       DateTime @default(now())

  // Relation with cascade on delete
  location        Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([timestamp])
  @@map("water_readings")
}
