// EcoMonitor Prisma Schema
// PostgreSQL Database Schema for Air Quality (AQI) and Water Quality (WQI) Monitoring

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Represents a geographic monitoring station / location
model Location {
  id            Int            @id @default(autoincrement())
  name          String
  latitude      Float
  longitude     Float
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // 1-to-many relationship with sensor readings
  airReadings   AirReading[]
  waterReadings WaterReading[]

  @@map("locations")
}

/// Represents an Air Quality sensor snapshot
model AirReading {
  id         Int      @id @default(autoincrement())
  locationId Int
  pm25       Float    // Particulate Matter ≤ 2.5 µm (µg/m³)
  pm10       Float    // Particulate Matter ≤ 10 µm (µg/m³)
  co2        Float    // Carbon Dioxide (parts per million)
  aqi_score  Float    // Standardized Air Quality Index (0 - 500)
  timestamp  DateTime @default(now())

  // Foreign key relation with cascade on delete
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([timestamp])
  @@map("air_readings")
}

/// Represents a Water Quality sensor snapshot
model WaterReading {
  id               Int      @id @default(autoincrement())
  locationId       Int
  ph               Float    // Potential of Hydrogen (0 - 14)
  turbidity        Float    // Water clarity/cloudiness in NTU
  dissolved_oxygen Float    // Dissolved Oxygen (mg/L)
  wqi_score        Float    // Standardized Water Quality Index (0 - 100)
  timestamp        DateTime @default(now())

  // Foreign key relation with cascade on delete
  location         Location @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([locationId])
  @@index([timestamp])
  @@map("water_readings")
}

