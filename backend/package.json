{
  "name": "ecotrack-backend",
  "version": "1.0.0",
  "description": "EcoTrack REST API (Express + Prisma + SQLite)",
  "main": "server.js",
  "scripts": {
    "setup": "prisma db push --skip-generate && prisma generate && node prisma/seed.js",
    "dev": "nodemon server.js",
    "start": "node server.js",
    "seed": "node prisma/seed.js",
    "test:math": "node src/utils/test-calculators.js",
    "db:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.3.0"
  }
}
